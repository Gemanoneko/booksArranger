 }
+
+// Invocation-local verified bytes; each worker remains a distinct ordinary source tree.
+export function pythonSourceInventory(directory,relative='',contents=null){
+ const files=[];
+ for(const item of fs.readdirSync(path.join(directory,relative),{withFileTypes:true}).sort((a,b)=>a.name.localeCompare(b.name))){
+  if(!relative&&['scratch','node_modules','.git','dist','build-cache'].includes(item.name))continue;
+  const name=path.join(relative,item.name),file=path.join(directory,name),stat=fs.lstatSync(file);
+  if(stat.isSymbolicLink())throw Error('Linked Python batch input');
+  if(stat.isDirectory())files.push(...pythonSourceInventory(directory,name,contents));
+  else if(stat.isFile()){const bytes=fs.readFileSync(file);files.push([name,createHash('sha256').update(bytes).digest('hex')]);if(contents)contents.set(name,bytes);}
+  else throw Error('Nonordinary Python batch input');
+ }
+ return files;
+}
+export function pythonWorkerSource(directory){
+ const contents=new Map(),inputs=pythonSourceInventory(directory,'',contents);
+ for(const item of inputs)Object.freeze(item);Object.freeze(inputs);
+ return Object.freeze({inputs,copy(destination){
+  for(const [name] of inputs){const file=path.join(destination,name);fs.mkdirSync(path.dirname(file),{recursive:true});fs.writeFileSync(file,contents.get(name),{flag:'wx'});}
+  if(JSON.stringify(pythonSourceInventory(destination))!==JSON.stringify(inputs))throw Error('Python batch copy differs: '+destination);
+ }});
+}
