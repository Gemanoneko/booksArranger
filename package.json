{
  "name": "books-arranger",
  "productName": "Books Arranger",
  "version": "0.16.1",
  "private": true,
  "description": "Inventory and arrange audiobook, podcast and ebook libraries",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "fetch-runtime": "node scripts/fetch-runtime.mjs",
    "stage-backend": "node scripts/stage-backend.mjs",
    "clean:dist": "node scripts/clean-dist.js",
    "pack": "node scripts/build-step.mjs pack",
    "release": "node scripts/release.mjs",
    "check": "node scripts/check-desktop.mjs"
  },
  "build": {
    "appId": "com.antigravity.booksarranger",
    "productName": "Books Arranger",
    "copyright": "Copyright © 2026 Antigravity Projects",
    "icon": "desktop/icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "files": [
      "desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-cache/backend",
        "to": "backend"
      },
      {
        "from": "build-cache/runtime/python",
        "to": "python"
      },
      {
        "from": "build-cache/runtime/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Gemanoneko",
      "repo": "booksArranger",
      "releaseType": "release"
    },
    "artifactName": "Books-Arranger-Setup-${version}.${ext}"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
